<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <!-- Configurations for VSTest execution -->
  <RunConfiguration>
    <!-- Limit simultaneous test executions to 2 threads / 2 CPU cores on CI runners -->
    <MaxCpuCount>2</MaxCpuCount>
  </RunConfiguration>

  <!-- NUnit adapter specific configurations -->
  <NUnit>
    <NumberOfTestWorkers>2</NumberOfTestWorkers>
    <DefaultTestNamePattern>{m}{a}</DefaultTestNamePattern>
    <StopOnError>false</StopOnError>
  </NUnit>
</RunSettings>
