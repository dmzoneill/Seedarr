<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <!-- Configurations for VSTest execution -->
  <RunConfiguration>
    <!-- Limit simultaneous test executions to 4 threads / 2 CPU cores on CI runners -->
    <MaxCpuCount>4</MaxCpuCount>
  </RunConfiguration>

  <!-- NUnit adapter specific configurations -->
  <NUnit>
    <NumberOfTestWorkers>4</NumberOfTestWorkers>
    <DefaultTestNamePattern>{m}{a}</DefaultTestNamePattern>
    <StopOnError>false</StopOnError>
    <!-- Per-test ceiling so a stuck await/network call cannot run for hours -->
    <DefaultTimeout>120000</DefaultTimeout>
  </NUnit>

</RunSettings>
